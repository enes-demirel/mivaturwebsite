{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mivatur",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
  "d1_databases": [{ "binding": "MIVATUR_DB", "database_name": "mivatur-db", "database_id": "19b5b4e3-1c12-42cf-b3cc-7a7451aaa28d", "migrations_dir": "cloudflare/migrations" }],
  "r2_buckets": [
    { "binding": "MIVATUR_MEDIA", "bucket_name": "mivatur-media" }
  ]
}
